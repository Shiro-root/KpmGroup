APP_NAME="KPM Group"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kpm_web
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@kpmgroup.co.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── KPM Group Config ─────────────────────────────
# WhatsApp: format internasional tanpa tanda + (62xxx)
KPM_WHATSAPP=6281234567890
KPM_WHATSAPP_DISPLAY=812-3456-7890

KPM_EMAIL=info@kpmgroup.co.id
KPM_ADDRESS="Jl. Contoh No. 123\nBandar Lampung, Lampung 35000\nIndonesia"

KPM_INSTAGRAM_URL=https://instagram.com/kpmgroup
KPM_INSTAGRAM_HANDLE=kpmgroup

KPM_TIKTOK_URL=https://tiktok.com/@kpmgroup
KPM_TIKTOK_HANDLE=kpmgroup

# Ganti dengan embed URL Google Maps lokasi kantor
KPM_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=YOUR_EMBED_URL
